---
/**
 * Contact / audit form. Posts to site.formEndpoint (bundled PHP handler or a form service).
 * Progressive enhancement: works as a plain POST; with JS it validates inline and submits via fetch.
 * Prefill: ?pakiet=<id> or ?konfiguracja=<text>&budzet=<option> (from the pricing calculator).
 */
import { site, isSet } from '../config/site';
import { budgetOptions } from '../data/pricing';
import { withBase } from '../lib/url';

export interface Props {
  /** Identifies the page the lead came from, e.g. "kontakt" or "audyt-seo". */
  source: string;
  submitLabel?: string;
  defaultMessage?: string;
}
const { source, submitLabel = 'Wyślij wiadomość', defaultMessage = '' } = Astro.props;
const endpoint = isSet(site.formEndpoint) ? withBase(site.formEndpoint) : '';
---

<form
  class="form"
  id="formularz"
  method="post"
  action={endpoint || '#'}
  novalidate
  data-contact-form
  data-endpoint={endpoint}
  aria-describedby="form-required-note"
>
  <p id="form-required-note" class="small muted">Pola oznaczone * są wymagane.</p>

  <div class="note config-box" data-config-box hidden>
    <p><strong>Wybrany zakres z kalkulatora:</strong></p>
    <p class="config-preview" data-config-preview></p>
  </div>

  <div class="form__row">
    <div class="field">
      <label for="f-name">Imię i nazwisko *</label>
      <input class="input" id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="f-name-err" />
      <span class="field__error" id="f-name-err"></span>
    </div>
    <div class="field">
      <label for="f-company">Firma *</label>
      <input class="input" id="f-company" name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby="f-company-err" />
      <span class="field__error" id="f-company-err"></span>
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label for="f-website">Adres strony www *</label>
      <input class="input" id="f-website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="np. twojafirma.pl" required maxlength="200" aria-describedby="f-website-err" />
      <span class="field__error" id="f-website-err"></span>
    </div>
    <div class="field">
      <label for="f-email">E-mail *</label>
      <input class="input" id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="f-email-err" />
      <span class="field__error" id="f-email-err"></span>
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label for="f-phone">Telefon <span class="optional">(opcjonalnie)</span></label>
      <input class="input" id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="f-phone-err" />
      <span class="field__error" id="f-phone-err"></span>
    </div>
    <div class="field">
      <label for="f-budget">Miesięczny budżet na SEO *</label>
      <select class="input" id="f-budget" name="budget" required aria-describedby="f-budget-err">
        <option value="">Wybierz</option>
        {budgetOptions.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
      <span class="field__error" id="f-budget-err"></span>
    </div>
  </div>

  <div class="field">
    <label for="f-message">Wiadomość *</label>
    <textarea class="input" id="f-message" name="message" required minlength="10" maxlength="5000" aria-describedby="f-message-err">{defaultMessage}</textarea>
    <span class="field__error" id="f-message-err"></span>
  </div>

  <input type="hidden" name="pricing_config" value="" data-config-field />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="started_at" value="" data-started-at />
  <div class="hp-field" aria-hidden="true">
    <label for="f-fax">Nie wypełniaj tego pola</label>
    <input id="f-fax" name="fax" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <div class="consent">
      <input id="f-consent" name="consent" type="checkbox" value="tak" required aria-describedby="f-consent-err" />
      <label for="f-consent">
        Wyrażam zgodę na przetwarzanie moich danych w celu odpowiedzi na zapytanie. Administratorem danych jest {site.legalName}.
        Szczegóły w <a href="/polityka-prywatnosci/">polityce prywatności</a>. *
      </label>
    </div>
    <span class="field__error" id="f-consent-err"></span>
  </div>

  <div class="form-status" role="status" aria-live="polite" data-form-status></div>
  <button type="submit" class="btn btn--primary">{submitLabel}</button>
</form>

<script>
  import { withBase } from '../lib/url';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const params = new URLSearchParams(location.search);
    form.querySelector<HTMLInputElement>('[data-started-at]')!.value = String(Date.now());

    // --- Prefill from pricing ---
    const packageNames: Record<string, string> = { start: 'START', growth: 'GROWTH', scale: 'SCALE' };
    let config = params.get('konfiguracja')?.slice(0, 1500) ?? '';
    const pkg = params.get('pakiet');
    if (!config && pkg && packageNames[pkg]) config = `Interesuje mnie pakiet: ${packageNames[pkg]}`;
    if (config) {
      form.querySelector<HTMLInputElement>('[data-config-field]')!.value = config;
      form.querySelector<HTMLElement>('[data-config-preview]')!.textContent = config;
      form.querySelector<HTMLElement>('[data-config-box]')!.hidden = false;
    }
    const budget = params.get('budzet');
    const budgetSelect = form.querySelector<HTMLSelectElement>('#f-budget')!;
    if (budget && [...budgetSelect.options].some((o) => o.value === budget)) budgetSelect.value = budget;

    // --- Validation ---
    const messages: Record<string, (el: HTMLInputElement) => string> = {
      name: (el) => (el.value.trim().length < 3 ? 'Podaj imię i nazwisko.' : ''),
      company: (el) => (el.value.trim().length < 2 ? 'Podaj nazwę firmy.' : ''),
      website: (el) =>
        /^(https?:\/\/)?([\p{L}\d-]+\.)+[\p{L}]{2,}(\/\S*)?$/iu.test(el.value.trim()) ? '' : 'Podaj adres strony, np. twojafirma.pl.',
      email: (el) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(el.value.trim()) ? '' : 'Podaj poprawny adres e-mail.'),
      phone: (el) => (el.value.trim() === '' || /^[+\d][\d\s()-]{6,}$/.test(el.value.trim()) ? '' : 'Podaj poprawny numer telefonu.'),
      budget: (el) => (el.value ? '' : 'Wybierz przybliżony budżet.'),
      message: (el) => (el.value.trim().length < 10 ? 'Napisz kilka słów o swoim celu (min. 10 znaków).' : ''),
      consent: (el) => (el.checked ? '' : 'Zgoda jest potrzebna, żebym mógł odpowiedzieć.'),
    };

    const validateField = (el: HTMLInputElement) => {
      const rule = messages[el.name];
      if (!rule) return true;
      const msg = rule(el);
      const err = document.getElementById(`${el.id}-err`);
      if (err) err.textContent = msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    };

    form.addEventListener('blur', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name in messages && el.value !== '') validateField(el);
    }, true);
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true') validateField(el);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'form-status';
      status.textContent = '';
      const fields = Object.keys(messages).map((n) => form.elements.namedItem(n) as HTMLInputElement);
      const invalid = fields.filter((el) => !validateField(el));
      if (invalid.length) {
        invalid[0].focus();
        status.className = 'form-status form-status--error';
        status.textContent = `Popraw zaznaczone pola (${invalid.length}).`;
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.className = 'form-status form-status--error';
        status.textContent = 'Formularz nie jest jeszcze skonfigurowany. Napisz bezpośrednio na adres e-mail podany w stopce.';
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      button.textContent = 'Wysyłanie…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        // Both the PHP handler and Formspree answer with JSON { ok: true }.
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || data.ok === false) throw new Error(String(res.status));
        location.href = withBase('/dziekujemy/');
      } catch {
        status.className = 'form-status form-status--error';
        status.textContent = 'Nie udało się wysłać wiadomości. Spróbuj ponownie lub napisz bezpośrednio na adres e-mail ze stopki.';
        button.disabled = false;
        button.textContent = 'Spróbuj ponownie';
      }
    });
  }
</script>
