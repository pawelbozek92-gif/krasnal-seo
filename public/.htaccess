# Apache settings for shared hosting (copied to the web root by the build).

ErrorDocument 404 /404.html
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the www host. TODO: uncomment after SSL is active and the domain is final.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.krasnalseo.pl%{REQUEST_URI} [L,R=301]

  # Add trailing slash to directory-style URLs (/cennik -> /cennik/).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build assets and fonts never change: cache for a year.
  <FilesMatch "\.(woff2|avif|webp|png|jpg|svg|ico|js|css|webm|mp4|opus|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.ico|og-default\.png|apple-touch-icon\.png|icon-\d+\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType audio/ogg .opus
  AddType audio/mpeg .mp3
</IfModule>

# Never serve the mail config if it was placed in the web root by mistake.
<Files "contact-config.php">
  Require all denied
</Files>
