{
  "name": "krasnal-seo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets": "node scripts/generate-assets.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
